<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymAI</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                
           
    background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)),
                url('/images/gym-bg.jpg');
    background-size: cover;
    background-position: center;

              
            }

            .navbar {
                background: linear-gradient(90deg, #4f46e5, #9333ea);
            }

            .navbar-brand {
                font-weight: bold;
                font-size: 1.5rem;
                color: white !important;
            }

            .navbar-nav .nav-link {
                color: white !important;
                margin-left: 15px;
            }

                .navbar-nav .nav-link:hover {
                    color: #ffd700 !important;
                }

            main {
                padding-top: 20px;
            }
    </style>
</head>

<body>

    <!-- ✅ NAVBAR START -->
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top">
        <div class="container-fluid px-4">

            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                🏋️ Gym<span class="text-warning">AI</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav ms-auto align-items-center">

                    <li class="nav-item">
                        <a class="nav-link active-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
               
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Services">Services</a>
                     
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Bmi" asp-action="Index">
                            BMI Calculator
                        </a>
                    </li>

                    

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Trainer" asp-action="Index">
                            Trainers
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Payment" asp-action="Index">Payments</a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Login">Login</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Logout">Logout</a>
                    </li>

                    <a asp-controller="Account" asp-action="Register">Register</a>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>
    
    <!-- ✅ NAVBAR END -->

    <div class="container-fluid px-4">
        <main>
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>