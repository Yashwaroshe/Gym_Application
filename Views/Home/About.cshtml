@{
    ViewData["Title"] = "About";
}

<div class="container py-5 text-center">

    <h1 class="fw-bold mb-3">About Our Gym</h1>
    <p class="lead text-muted">
        Transform your body, transform your life. We provide world-class fitness solutions.
    </p>

    <div class="row mt-5">

        <div class="col-md-4">
            <div class="card p-4 shadow-lg bg-dark text-white">
                <i class="fas fa-dumbbell fa-2x mb-3 text-warning"></i>
                <h4>Modern Equipment</h4>
                <p>Top-quality machines for best workout experience.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 shadow-lg bg-dark text-white">
                <i class="fas fa-user-friends fa-2x mb-3 text-warning"></i>
                <h4>Expert Trainers</h4>
                <p>Certified trainers to guide your fitness journey.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-4 shadow-lg bg-dark text-white">
                <i class="fas fa-heartbeat fa-2x mb-3 text-warning"></i>
                <h4>Healthy Lifestyle</h4>
                <p>We help you build long-term healthy habits.</p>
            </div>
        </div>

    </div>

</div>