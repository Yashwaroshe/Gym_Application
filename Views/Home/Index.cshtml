
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gym Management System</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
    

    <!-- Hero Section -->


    <div class="hero-section text-center text-white">
        <h1>Welcome to Our Gym!</h1>
        <p class="lead">Your fitness journey starts here. Manage members, explore services, and get AI-powered fitness tips.</p>

    </div>
<div class="container text-center mt-5">
        <a href="/member/Index.cshtml" class="btn btn-primary btn-lg mt-3">
            <i class="fas fa-users"></i> View Members
        </a>
        <a href="/AI/FitnessTips" class="btn btn-success btn-lg mt-3">
            <i class="fas fa-dumbbell"></i> Get Fitness Tips
        </a>
    </div>
    <div class="container-fluid mt-4">
        <div class="row g-4">

            <!-- Trainers Card -->
            <div class="col-md-4">
                <div class="card text-white bg-dark shadow-lg border-0 rounded-4 p-4 text-center">
                    
                    <h4>🏋️ Trainers</h4>
                    <p>Expert guidance available</p>
                </div>
            </div>

            <!-- Plans Card -->
            <div class="col-md-4">
                <div class="card text-white bg-dark shadow-lg border-0 rounded-4 p-4 text-center">
                    <h4>💳 Plans</h4>
                    <p>Affordable membership plans</p>
                </div>
            </div>

            <!-- Progress Card -->
            <div class="col-md-4">
                <div class="card text-white bg-dark shadow-lg border-0 rounded-4 p-4 text-center">
                    <h4>📊 Progress</h4>
                    <p>Track your fitness journey</p>
                </div>
            </div>

        </div>
    </div>

  


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>