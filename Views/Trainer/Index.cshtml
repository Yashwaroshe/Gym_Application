@{
    ViewData["Title"] = "Trainers";
}

<h2 class="text-center mt-4">🏋️ Our Trainers</h2>

<div class="container mt-4">
    <div class="row">

        <!-- Trainer 1 -->
        <div class="col-md-4">
            <div class="card trainer-card text-center p-3">
                <img src="~/img/traner1.jpg" class="rounded-circle mx-auto" />
