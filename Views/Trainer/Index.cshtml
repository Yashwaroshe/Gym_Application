                <p>Cardio Expert</p>
                <p>Experience: 3 Years</p>
                <button class="btn btn-success">Book Trainer</button>
            </div>
        </div>

        <!-- Trainer 3 -->
        <div class="col-md-4">
            <div class="card trainer-card text-center p-3">
                <img src="~/img/traner2.jpg" class="rounded-circle mx-auto" />   
                <h4 class="mt-2">Sneha</h4>
                <p>Yoga Trainer</p>
                <p>Experience: 4 Years</p>
